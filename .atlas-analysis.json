  "keyFeatures": [
    "OpenAI-compatible inference gateway with multi-provider routing",
    "Chat completions, streaming SSE, and tool calling",
    "Anthropic Messages API compatibility",
    "Vision (image input) support for capable models",
    "System One typed decision models (Jev)",
    "SIRS: multi-engine web search via SearXNG",
    "CROWD: URL scraping, site crawling, site mapping, structured extraction, and llms.txt generation via Firecrawl",
    "Automatic context compaction for long conversations",
    "Automatic tool-call argument integrity and repair during streaming",
    "Pre-upload image hosting for large images",
    "Three flat-rate subscription tiers with unlimited tokens"
  ],
  "publicApiSurface": [
